# LexiGuard Environment Configuration Template
# Copy this file to .env inside the backend directory and configure your actual credentials.
# NEVER commit .env to version control.

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection URI
# Example: mongodb+srv://lexiguard_app:<password>@lexiguard-cluster.aofcopa.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_srv_uri_here

# MongoDB Application Database Name
MONGODB_DATABASE=lexiguard

# Deployed Frontend Origin for CORS (e.g., https://your-project.vercel.app)
# Comma-separated if allowing multiple preview/custom domains
FRONTEND_URL=https://your-project.vercel.app

# Server Port (Render injects PORT automatically; defaults to 5000 locally)
PORT=5000
